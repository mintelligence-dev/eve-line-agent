# LINE Messaging API — LINE Developers Console → your channel → Basic settings / Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Durable state. Without it the adapter falls back to in-memory state and
# loses reply tokens, thread subscriptions, and the greeting flag on every
# cold start. Any Redis URL works (Upstash, Vercel Marketplace Redis, local).
REDIS_URL=

# Model provider. The agent calls Anthropic directly (agent/agent.ts), so it
# needs a Claude Console key from https://console.anthropic.com/settings/keys —
# locally and on Vercel alike.
ANTHROPIC_API_KEY=

# Salesforce — demo requests become Leads in the company org. Deploy
# salesforce/ to the org first (README → Demo requests go to Salesforce), then
# copy the app's consumer key and secret here. Leave these empty to keep
# requests in .data/demo-requests.jsonl only. SALESFORCE_LOGIN_URL is the
# org's My Domain URL, e.g. https://yourcompany.my.salesforce.com
SALESFORCE_LOGIN_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Optional. Lead Source value on each Lead; defaults to LINE.
SALESFORCE_LEAD_SOURCE=

# LINE group of the sales team, where each demo request is posted and booked
# (README → Demo booking in the sales team's LINE group). Invite the bot to
# the group and it replies with the ID to put here. Leave empty to skip the
# group: requests are still saved.
LINE_SALES_GROUP_ID=
