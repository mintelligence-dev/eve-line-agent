<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Lets sales see the LINE demo booking on a Lead: the reference code the agent gives customers, the customer's preferred day, the booked date, and its status. The agent keeps them up to date from the LINE group.</description>
    <fieldPermissions>
        <editable>false</editable>
        <field>Lead.Demo_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Lead.Demo_Preferred_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Lead.Demo_Reference__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Lead.Demo_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <label>M Intel LINE Agent - Sales</label>
</PermissionSet>
